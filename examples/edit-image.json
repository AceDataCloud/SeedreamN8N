{
  "name": "Seedream \u2014 edit image",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "setup-notes",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -300],
      "parameters": {
        "content": "## Seedream through AceDataCloud\nInstall @acedatacloud/n8n-nodes-seedream. Select your API credential on Create and Get Task. Each input item creates one paid task. The loop queries that same ID and stops after 30 minutes; it never resubmits generation.",
        "height": 230,
        "width": 540
      }
    },
    {
      "id": "create",
      "name": "Create",
      "type": "@acedatacloud/n8n-nodes-seedream.seedream",
      "typeVersion": 1,
      "position": [220, 0],
      "parameters": {
        "resource": "image",
        "operation": "edit",
        "model": "doubao-seedream-5-0-lite-260128",
        "prompt": "Preserve the composition and change the background to pale blue",
        "size": "2K",
        "responseFormat": "url",
        "simplify": true,
        "imageUrls": "https://cdn.acedata.cloud/b1c82e4937.png"
      },
      "retryOnFail": false
    },
    {
      "id": "initialize",
      "name": "Initialize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "taskId",
              "name": "taskId",
              "value": "={{ $json.taskId }}",
              "type": "string"
            },
            {
              "id": "deadline",
              "name": "deadline",
              "value": "={{ $now.plus({ minutes: 30 }).toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wait-15-seconds",
      "name": "Wait 15 Seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 0],
      "parameters": {
        "resume": "timeInterval",
        "amount": 15,
        "unit": "seconds"
      },
      "webhookId": "seedream-generation-wait"
    },
    {
      "id": "get-task",
      "name": "Get Task",
      "type": "@acedatacloud/n8n-nodes-seedream.seedream",
      "typeVersion": 1,
      "position": [880, 0],
      "parameters": {
        "resource": "task",
        "operation": "get",
        "taskId": "={{ $('Initialize').first().json.taskId }}",
        "simplify": true
      }
    },
    {
      "id": "finished",
      "name": "Finished",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.finished }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "succeeded",
      "name": "Succeeded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, -100],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.successful === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "deadline-reached",
      "name": "Deadline Reached",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 180],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $now.toMillis() >= Date.parse($('Initialize').first().json.deadline) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "result",
      "name": "Result",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1540, -180],
      "parameters": {}
    },
    {
      "id": "generation-failed",
      "name": "Generation Failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1540, -20],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ \"Generation failed for task \" + $json.taskId + \": \" + JSON.stringify($json.error) }}"
      }
    },
    {
      "id": "stop-waiting",
      "name": "Stop Waiting",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1540, 180],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ 'Stopped waiting after 30 minutes. Query task ' + $('Initialize').first().json.taskId + ' again later; do not resubmit Create.' }}"
      }
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Create",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create": {
      "main": [
        [
          {
            "node": "Initialize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize": {
      "main": [
        [
          {
            "node": "Wait 15 Seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 15 Seconds": {
      "main": [
        [
          {
            "node": "Get Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Task": {
      "main": [
        [
          {
            "node": "Finished",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished": {
      "main": [
        [
          {
            "node": "Succeeded",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Deadline Reached",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Succeeded": {
      "main": [
        [
          {
            "node": "Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Generation Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deadline Reached": {
      "main": [
        [
          {
            "node": "Stop Waiting",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait 15 Seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 1900
  },
  "active": false,
  "tags": []
}
